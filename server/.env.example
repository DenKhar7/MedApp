# Mot de passe root MariaDB : utilis? UNIQUEMENT par le conteneur mariadb (jamais transmis au serveur)
MARIADB_ROOT_PASSWORD=
# Compte des jobs d'import (droits limit?s aux bases active/temp/archive)
MARIADB_USER=
MARIADB_PASSWORD=
# Compte de l'API : lecture seule sur med_db_views
API_DB_USER=
API_DB_PASSWORD=

# Valeurs autoris?es pour les comptes/mots de passe : lettres, chiffres et _ . @ + -
API_HOST=0.0.0.0
API_PORT=4000
API_SCHEME=http
# Nom de domaine pointant (enregistrement A) vers l'IP du VPS : Caddy en tire un certificat HTTPS
API_DOMAIN=api.example.com
